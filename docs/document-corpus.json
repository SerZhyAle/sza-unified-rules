{
  "visibility": "published",
  "registry": "docs/DOCUMENT_REGISTRY.jsonl",
  "map": "docs/DOCS_MAP.md",
  "roots": ["README.md", "AGENTS.md", "CLAUDE.md", "EXPERIENCE_MAP.md", "rules", "skills", "hooks", "tools", "docs", "templates", "memory", ".claude/rules"],
  "ignore": [
    {"pattern": "rules/contrib/history/*.md", "reason": "Frozen dated project history, read by no skill; the current facts are in rules/contrib/<project>.md."}
  ],
  "generated": [
    {
      "pattern": "docs/releases/RELEASES.md",
      "generator": "pwsh -NoProfile -File tools/harness/releases/release-ledger.ps1 render",
      "check": "pwsh -NoProfile -File tools/harness/releases/release-ledger.ps1 show"
    }
  ]
}
