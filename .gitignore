# Secrets and signing material - pre-empt the leak, never catch it afterwards.
*.pfx
*.snk
*.jks
*.keystore
*.p12
*.pem
*.cer
.env
*token*
*secret*
# The two name globs above also hide product source whose name holds the word (RoomSecretStore.kt): keep them, and
# add a narrow per-file negation with a why-comment for that file - SZA-SEC05 of check-compliance names it.

# Scratch
temp/
tmp/

# Local launchers written by tools/harness/portfolio/install-shortcuts.ps1 - machine paths, never shipped.
/PQ *.lnk

# Build junk - deploy.ps1 stages everything, so this has to be excluded here or not at all.
__pycache__/
*.pyc
bin/
obj/

PLAN/
dev/DOCUMENT_REGISTRY.jsonl
dev/DOCS_MAP.md
dev/document-corpus.json

# The canon's own harness profile stays in this checkout: the harness looks for a profile above its own root (_profile.ps1 step 3), so a shipped one would become the project root of every consumer that has none.
/.sza-profile.json
